# Same value as "Application ID" in Discord Developer Portal → General Information
# (OAuth2 client id — not the bot token.)
VITE_DISCORD_CLIENT_ID=

# Leave EMPTY in production when the UI is on Vercel and you use activity/vercel.json to rewrite
# /api/* → your Railway bot (same-origin requests; required inside Discord — direct Railway URLs are CSP-blocked).
# Only set VITE_API_BASE_URL for local dev or if API and UI truly share one origin without a rewrite.
# VITE_API_BASE_URL=

# Local only: where Vite proxies /api (default http://127.0.0.1:8080 — your bot HTTP port).
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

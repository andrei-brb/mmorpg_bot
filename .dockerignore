# Smaller build context + image → faster Railway uploads and fewer registry timeouts.
# Keep anything the bot loads at runtime or the Vite stage needs under `activity/`.

# VCS / CI
.git
.github

# Python — local + caches (image installs deps via requirements.txt)
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# Discord Activity — deps and output are produced inside the Dockerfile
activity/node_modules/
activity/dist/
activity/.env
activity/.vite/
**/*.tsbuildinfo
activity/playwright-report/
activity/test-results/

# Mobile app (Capacitor) — a separate client build; the bot/backend never uses it.
# Excluded entirely so it can't bloat the Railway build context or image.
mobile/
# Design references / vendored samples — not imported by the app
activity/realm-whispers-client-main/
activity/explore tab v2/

# Icon & asset **pipelines** (outputs live in `activity/public/` and ship in `activity/dist/`)
items_processed/
mobs_processed/
bestiary_reprocessed/
bestiary_reprocessed_v2/
bestiary_grid.png
items_gridpng.png
# Tooling output tree — runtime uses `assets/items` + Activity `dist` URLs
icons/

# Dev / docs — not loaded by `python main.py`
tests/
scripts/
v0/
.claude/
**/*.md

# OS / editor
.DS_Store
.cursor/
.vscode/

# Logs & local artifacts
*.log
world-of-discord-activity-ui.zip
bot_run.log
bot_restart.log
bot_output.log

## Required
# Get from Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=

# PostgreSQL connection string
DATABASE_URL=postgresql://mmorpg_user:yourpassword@localhost:5432/mmorpg

## Optional
# Application ID (Developer Portal → General Information). Same as VITE_DISCORD_CLIENT_ID for the Activity build.
DISCORD_APPLICATION_ID=

# Activity HTTP API (OAuth + inventory JSON). Get Client Secret from OAuth2 page (not the bot token).
DISCORD_CLIENT_SECRET=

# HTTP port for Activity API (Railway sets PORT automatically).
# ACTIVITY_HTTP_PORT=8080

# If Activity is on another origin than the API, list allowed origins (comma-separated).
# ACTIVITY_CORS_ORIGINS=https://your-app.vercel.app

# Only if Discord token exchange complains about redirect_uri — must match OAuth2 redirect list exactly.
# DISCORD_OAUTH_REDIRECT_URI=https://your-public-url/

LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0

# Stripe (monetization hooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SERVER_PREMIUM_PRICE_ID=
STRIPE_PLAYER_PREMIUM_PRICE_ID=

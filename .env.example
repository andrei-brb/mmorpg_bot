## Required
# Get from Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=

# PostgreSQL connection string
DATABASE_URL=postgresql://mmorpg_user:yourpassword@localhost:5432/mmorpg

## Optional
# Application ID (Developer Portal → General Information). Used by /activity embed; same ID as VITE_DISCORD_CLIENT_ID for the web client.
DISCORD_APPLICATION_ID=

LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0

# Stripe (monetization hooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SERVER_PREMIUM_PRICE_ID=
STRIPE_PLAYER_PREMIUM_PRICE_ID=

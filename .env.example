## Required
# Get from Discord Developer Portal -> Your App -> Bot -> Reset Token
DISCORD_TOKEN=

# PostgreSQL connection string
DATABASE_URL=postgresql://mmorpg_user:yourpassword@localhost:5432/mmorpg

## Optional
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379/0

# Stripe (monetization hooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SERVER_PREMIUM_PRICE_ID=
STRIPE_PLAYER_PREMIUM_PRICE_ID=

# The mobile app talks to the SAME backend as the Discord game (cross-play).
# Point this at the Railway API base (no trailing slash).
VITE_API_BASE_URL=https://worker-production-1427.up.railway.app

# Discord OAuth client id — used by the standalone Discord login on mobile (Phase 1).
VITE_DISCORD_CLIENT_ID=

# Discord redirect. Discord only accepts https (not custom schemes), so this is
# the backend bounce page — register THIS exact URL in the Discord Developer
# Portal → OAuth2 → Redirects. It forwards the login into the app's deep link.
VITE_DISCORD_REDIRECT_URI=https://worker-production-1427.up.railway.app/auth/mobile-callback
# The app's custom-scheme deep link the OS routes back to (matches Info.plist).
VITE_DISCORD_APP_DEEPLINK=com.wold.mmo://auth/discord

# Dev-only: local backend proxy target for `npm run dev`.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080
